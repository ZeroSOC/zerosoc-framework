{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroSOC/zerosoc-framework/02-Taxonomy/case_schema.json",
  "title": "ZeroSOC Case",
  "description": "A ZeroSOC Case: the subset of the OCSF Incident Finding [2005] fields the framework uses, plus the framework's own fields under the 'zerosoc' extension object. A Case becomes an Incident when verdict_id = 2. See case_schema.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "uid",
    "status_id",
    "severity_id",
    "verdict_id",
    "finding_info_list",
    "zerosoc"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "description": "Case identifier, cited by the Notes, tuning tickets and metrics."
    },
    "status_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "x-enum-captions": {
        "1": "New",
        "2": "In Progress",
        "3": "On Hold",
        "4": "Resolved",
        "5": "Closed"
      }
    },
    "severity_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "x-enum-captions": {
        "1": "Informational",
        "2": "Low",
        "3": "Medium",
        "4": "High",
        "5": "Critical"
      }
    },
    "confidence_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "x-enum-captions": {
        "1": "Low",
        "2": "Medium",
        "3": "High"
      }
    },
    "impact_id": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "x-enum-captions": {
        "0": "Unknown",
        "1": "Low",
        "2": "Medium",
        "3": "High",
        "4": "Critical"
      }
    },
    "verdict_id": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        5,
        7,
        10
      ],
      "x-enum-captions": {
        "0": "Unknown",
        "1": "False Positive",
        "2": "True Positive",
        "5": "Benign",
        "7": "Insufficient Data",
        "10": "Duplicate"
      }
    },
    "assignee": {
      "$ref": "#/$defs/ocsf_user",
      "description": "The Case assignee: the executor responsible for advancing the Case and for its verdict."
    },
    "desc": {
      "type": "string",
      "description": "The Case Summary: what happened and when, the entities involved and which acted on which, and the root cause once established."
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_note"
      },
      "description": "The Triage Note and the Investigation Note: renderings of the Case at their gate."
    },
    "finding_info_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ocsf_finding_info"
      },
      "description": "Every entry of the Case's record: the Alerts first, then the result of every check and validation query, and the response actions taken on the Case."
    },
    "attacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_attack"
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_observable"
      },
      "description": "Normalized entities — the join keys of the investigation."
    },
    "start_time": {
      "type": "integer",
      "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). The earliest event or finding that contributed to the Case. It opens at the earliest Alert's own start_time and moves earlier whenever a Malicious Finding cites an earlier event; a benign precursor examined and ruled out contributed to the investigation and not to the Case, and never moves it. On a confirmed Incident this is T0, the earliest confirmed malicious event."
    },
    "end_time": {
      "type": "integer",
      "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). The most recent event or finding that contributed to the Case."
    },
    "vendor_attributes": {
      "type": "object",
      "x-ocsf-object": "vendor_attributes",
      "additionalProperties": true,
      "description": "What the source reported before triage assessed it.",
      "properties": {
        "severity": {
          "type": "string"
        },
        "severity_id": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "x-enum-captions": {
            "1": "Informational",
            "2": "Low",
            "3": "Medium",
            "4": "High",
            "5": "Critical"
          }
        }
      }
    },
    "is_suspected_breach": {
      "type": "boolean"
    },
    "tickets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_ticket"
      },
      "description": "Tickets the Case raised; the Phase 1 tuning ticket carries type tuning."
    },
    "zerosoc": {
      "$ref": "#/$defs/zerosoc_extension"
    }
  },
  "$defs": {
    "ocsf_user": {
      "type": "object",
      "x-ocsf-object": "user",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type_id": {
          "type": "integer"
        }
      }
    },
    "ocsf_product": {
      "type": "object",
      "x-ocsf-object": "product",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ocsf_attack": {
      "type": "object",
      "x-ocsf-object": "attack",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "tactic": {
          "type": "object",
          "x-ocsf-object": "tactic",
          "additionalProperties": true,
          "required": [],
          "properties": {
            "uid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "technique": {
          "type": "object",
          "x-ocsf-object": "technique",
          "additionalProperties": true,
          "required": [
            "uid"
          ],
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^(T[0-9]{4}(\\.[0-9]{3})?|AML\\.T[0-9]{4}(\\.[0-9]{3})?)$"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "sub_technique": {
          "type": "object",
          "x-ocsf-object": "sub_technique",
          "additionalProperties": true,
          "required": [],
          "properties": {
            "uid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ocsf_observable": {
      "type": "object",
      "x-ocsf-object": "observable",
      "additionalProperties": true,
      "required": [
        "name",
        "type_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type_id": {
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ocsf_related_event": {
      "type": "object",
      "x-ocsf-object": "related_event",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "type_uid": {
          "type": "integer"
        },
        "type_name": {
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/ocsf_product"
        }
      },
      "description": "An event grounding a Finding, the Detection Finding where the Finding is an Alert, or — on an action entry — the Remediation Activity it records; type_uid is that event's OCSF class."
    },
    "ocsf_finding_info": {
      "type": "object",
      "x-ocsf-object": "finding_info",
      "additionalProperties": true,
      "required": [
        "uid",
        "title"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "created_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_attack"
          }
        },
        "related_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_related_event"
          }
        },
        "product": {
          "$ref": "#/$defs/ocsf_product"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "alert",
              "finding",
              "action"
            ]
          },
          "description": "alert for an aggregated Alert, finding for the result of a check or query, action for a response action."
        },
        "analytic": {
          "$ref": "#/$defs/ocsf_analytic"
        },
        "tags": {
          "type": "array",
          "description": "The side and the confidence of a Finding, and whether the Case Timeline renders the entry. A Finding that bears on no hypothesis, and every action entry, carries neither side nor confidence.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ocsf_key_value_object"
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:side"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "Malicious",
                        "Benign"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:confidence_id"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "1",
                        "2",
                        "3"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:timeline"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "true"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "attack_graph": {
          "$ref": "#/$defs/ocsf_graph"
        }
      },
      "description": "One entry of the Case's record: a Finding — an Alert, or the result of a check or validation query — or a response action taken on the Case."
    },
    "ocsf_ticket": {
      "type": "object",
      "x-ocsf-object": "ticket",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "src_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "incident_category": {
      "type": "string",
      "pattern": "^IC-[0-9]{2}$"
    },
    "executor_class": {
      "type": "string",
      "enum": [
        "human",
        "automation",
        "agent"
      ]
    },
    "zerosoc_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_path",
        "provenance"
      ],
      "properties": {
        "candidate_incident_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/incident_category"
          }
        },
        "incident_category": {
          "$ref": "#/$defs/incident_category"
        },
        "reclassification_pivots": {
          "type": "array",
          "description": "Every change of candidate Incident Category, with the evidence that triggered it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/incident_category"
              },
              "to": {
                "$ref": "#/$defs/incident_category"
              },
              "reason": {
                "type": "string"
              },
              "event_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "entry_path": {
          "type": "string",
          "enum": [
            "alert",
            "hunt",
            "out-of-band"
          ]
        },
        "visibility_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "data_source",
              "check_prevented"
            ],
            "properties": {
              "data_source": {
                "type": "string"
              },
              "check_prevented": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "playbooks",
            "executors"
          ],
          "properties": {
            "playbooks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "version"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string",
                    "description": "The playbook's last_updated date."
                  }
                }
              }
            },
            "executors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/executor_class"
              },
              "minItems": 1
            },
            "capability_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ocsf_product"
              }
            }
          }
        },
        "significant": {
          "type": "boolean",
          "description": "NIS2 Article 23(3) significance test."
        },
        "cross_border": {
          "type": "boolean"
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "recipient",
              "deadline"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "internal",
                  "nis2-early-warning",
                  "nis2-notification",
                  "nis2-final-report",
                  "dora-initial",
                  "dora-intermediate",
                  "dora-final",
                  "other"
                ]
              },
              "recipient": {
                "type": "string"
              },
              "deadline": {
                "type": "integer",
                "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
              },
              "sent_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "handover_reason": {
          "type": "string",
          "enum": [
            "crown-jewel",
            "privileged-identity",
            "manual"
          ]
        },
        "watch_until": {
          "type": "integer",
          "description": "OCSF timestamp_t: monitoring watch on the Case's entities after an Insufficient Data or Low-confidence close."
        },
        "master_case_uid": {
          "type": "string",
          "description": "Set on a Duplicate close: the open master Case that handles the activity."
        }
      }
    },
    "ocsf_key_value_object": {
      "type": "object",
      "x-ocsf-object": "key_value_object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "values"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ocsf_analytic": {
      "type": "object",
      "x-ocsf-object": "analytic",
      "additionalProperties": true,
      "description": "The check or validation query that produced the Finding.",
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "type_id": {
          "type": "integer"
        },
        "desc": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "ocsf_graph_node": {
      "type": "object",
      "x-ocsf-object": "node",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "description": "The entity's value as it appears in observables."
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "The entity's OCSF observable type_id."
        },
        "desc": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "ocsf_graph_edge": {
      "type": "object",
      "x-ocsf-object": "edge",
      "additionalProperties": true,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The acting entity's node uid."
        },
        "target": {
          "type": "string",
          "description": "The node uid of the entity acted on."
        },
        "relation": {
          "type": "string",
          "description": "An ATT&CK technique identifier where the edge is an observed technique, otherwise a STIX 2.1 relationship type."
        },
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "is_directed": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "ocsf_graph": {
      "type": "object",
      "x-ocsf-object": "graph",
      "additionalProperties": true,
      "required": [
        "nodes"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "is_directed": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_graph_node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_graph_edge"
          }
        }
      }
    },
    "ocsf_note": {
      "type": "object",
      "x-ocsf-object": "note",
      "additionalProperties": true,
      "required": [
        "comment"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "The deliverable's name, per the naming convention."
        },
        "comment": {
          "type": "string",
          "description": "The rendering of the Case at this gate."
        },
        "owner": {
          "$ref": "#/$defs/ocsf_user"
        },
        "created_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        },
        "modified_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        }
      }
    }
  }
}
