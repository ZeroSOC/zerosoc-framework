{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroSOC/zerosoc-framework/02-Taxonomy/case_schema.json",
  "title": "ZeroSOC Case",
  "description": "A ZeroSOC Case: the subset of the OCSF Incident Finding [2005] fields the framework uses, plus the framework's own fields under the 'zerosoc' extension object. A Case becomes an Incident when verdict_id = 2. See case_schema.md. A property this schema does not name is one source's own record, under that source's key.",
  "ocsf_version": "1.9.0",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "description": "A per-source extension: one object per source, under the source's own key, its shape declared by that source's own description and validated against it. Anything the framework already carries is a mapping and not an extension, and a scalar added at this level is neither."
  },
  "required": [
    "uid",
    "status_id",
    "severity_id",
    "verdict_id",
    "start_time",
    "finding_info_list",
    "zerosoc"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "description": "Case identifier, cited by the Notes, tuning tickets and metrics."
    },
    "status_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "x-enum-captions": {
        "1": "New",
        "2": "In Progress",
        "3": "On Hold",
        "4": "Resolved",
        "5": "Closed"
      }
    },
    "severity_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "x-enum-captions": {
        "1": "Informational",
        "2": "Low",
        "3": "Medium",
        "4": "High",
        "5": "Critical"
      }
    },
    "confidence_id": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "x-enum-captions": {
        "1": "Low",
        "2": "Medium",
        "3": "High"
      }
    },
    "impact_id": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "x-enum-captions": {
        "0": "Unknown",
        "1": "Low",
        "2": "Medium",
        "3": "High",
        "4": "Critical"
      }
    },
    "verdict_id": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        5,
        7,
        10
      ],
      "x-enum-captions": {
        "0": "Unknown",
        "1": "False Positive",
        "2": "True Positive",
        "5": "Benign",
        "7": "Insufficient Data",
        "10": "Duplicate"
      }
    },
    "assignee": {
      "$ref": "#/$defs/ocsf_user",
      "description": "The Case assignee: the executor responsible for advancing the Case and for its verdict."
    },
    "desc": {
      "type": "string",
      "description": "The Case Summary: what happened and when, the entities involved and which acted on which, and the root cause once established."
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_note"
      },
      "description": "The Triage Note and the Investigation Note: renderings of the Case at their gate."
    },
    "finding_info_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ocsf_finding_info"
      },
      "description": "Every entry of the Case's record: the Alerts first, then the result of every check and validation query, and the response actions taken on the Case."
    },
    "attacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_attack"
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_observable"
      },
      "description": "Normalized entities — the join keys of the investigation."
    },
    "start_time": {
      "type": "integer",
      "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). The earliest event or finding that contributed to the Case. It opens at the earliest Alert's own start_time and moves earlier whenever a Malicious Finding cites an earlier event; a benign precursor examined and ruled out contributed to the investigation and not to the Case, and never moves it. On a confirmed Incident this is T0, the earliest confirmed malicious event. On a Case closed as a False Positive or a Benign Positive it is still the earliest Alert's own start and nothing more: nothing malicious was confirmed, so it is not T0 and anchors no metric."
    },
    "end_time": {
      "type": "integer",
      "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). The most recent event or finding that contributed to the Case."
    },
    "vendor_attributes": {
      "type": "object",
      "x-ocsf-object": "vendor_attributes",
      "additionalProperties": true,
      "description": "What the source reported before triage assessed it.",
      "properties": {
        "severity": {
          "type": "string"
        },
        "severity_id": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "x-enum-captions": {
            "1": "Informational",
            "2": "Low",
            "3": "Medium",
            "4": "High",
            "5": "Critical"
          }
        }
      }
    },
    "is_suspected_breach": {
      "type": "boolean"
    },
    "tickets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocsf_ticket"
      },
      "description": "Tickets the Case raised; the Phase 1 tuning ticket carries type tuning."
    },
    "zerosoc": {
      "$ref": "#/$defs/zerosoc_extension"
    }
  },
  "$defs": {
    "ocsf_user": {
      "type": "object",
      "x-ocsf-object": "user",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type_id": {
          "type": "integer"
        }
      }
    },
    "ocsf_product": {
      "type": "object",
      "x-ocsf-object": "product",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ocsf_attack": {
      "type": "object",
      "x-ocsf-object": "attack",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "tactic": {
          "type": "object",
          "x-ocsf-object": "tactic",
          "additionalProperties": true,
          "required": [],
          "properties": {
            "uid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "technique": {
          "type": "object",
          "x-ocsf-object": "technique",
          "additionalProperties": true,
          "required": [
            "uid"
          ],
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^(T[0-9]{4}(\\.[0-9]{3})?|AML\\.T[0-9]{4}(\\.[0-9]{3})?)$"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "sub_technique": {
          "type": "object",
          "x-ocsf-object": "sub_technique",
          "additionalProperties": true,
          "required": [],
          "properties": {
            "uid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "version": {
          "type": "string"
        }
      }
    },
    "ocsf_observable": {
      "type": "object",
      "x-ocsf-object": "observable",
      "additionalProperties": true,
      "required": [
        "name",
        "type_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type_id": {
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ocsf_related_event": {
      "type": "object",
      "x-ocsf-object": "related_event",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "description": "Where the event is in OCSF, its metadata.uid."
        },
        "type_uid": {
          "type": "integer",
          "description": "The event's OCSF class."
        },
        "type_name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Used instead of type_uid where the event is not in OCSF."
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "severity_id": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "x-enum-captions": [
            "Informational",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "count": {
          "type": "integer",
          "description": "How many occurrences this one reference stands for."
        },
        "observables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_observable"
          }
        },
        "created_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        },
        "first_seen_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). When the event happened. The Case's start_time is the earliest of these across its Malicious Findings."
        },
        "last_seen_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        },
        "product": {
          "$ref": "#/$defs/ocsf_product"
        }
      },
      "description": "An event that is evidence of the Finding: what the Finding rests on, kept with the Case and cited by identifier. It may be any OCSF event — a Detection Finding where the Finding is an Alert, a Remediation Activity on an action entry, an event of the telemetry a query returned — or an event that is not in OCSF at all, which `type` names instead of `type_uid`. What is left out is what the Finding did not rest on: bulk telemetry, result sets, message bodies, file content."
    },
    "ocsf_finding_info": {
      "type": "object",
      "x-ocsf-object": "finding_info",
      "additionalProperties": true,
      "required": [
        "uid",
        "title"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "created_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
        },
        "first_seen_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). When the thing the Finding reports was first observed, which is not when the Finding was made. The Case Timeline orders on this, and the Case's start_time is the earliest of them."
        },
        "last_seen_time": {
          "type": "integer",
          "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC). When it was last observed."
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_attack"
          }
        },
        "related_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocsf_related_event"
          }
        },
        "product": {
          "$ref": "#/$defs/ocsf_product"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "alert",
              "finding",
              "action"
            ]
          },
          "description": "alert for an aggregated Alert, finding for the result of a check or query, action for a response action."
        },
        "analytic": {
          "$ref": "#/$defs/ocsf_analytic"
        },
        "traits": {
          "type": "array",
          "description": "Characteristics of the entity the Finding is about, surfaced from the event. On an Alert this is where the threat name and family the detection assigned are carried: category 'malware', name the family, values the threat names the source assigned.",
          "items": {
            "$ref": "#/$defs/ocsf_trait"
          }
        },
        "tags": {
          "type": "array",
          "description": "The side and the confidence of a Finding, and whether the Case Timeline renders the entry. A Finding that bears on no hypothesis, and every action entry, carries neither side nor confidence.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ocsf_key_value_object"
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:side"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "Malicious",
                        "Benign"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:confidence_id"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "1",
                        "2",
                        "3"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "const": "zerosoc:timeline"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "enum": [
                        "true"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "attack_graph": {
          "$ref": "#/$defs/ocsf_graph"
        }
      },
      "description": "One entry of the Case's record: a Finding — an Alert, or the result of a check or validation query — or a response action taken on the Case."
    },
    "ocsf_ticket": {
      "type": "object",
      "x-ocsf-object": "ticket",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "type_id": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            99
          ],
          "x-enum-captions": {
            "0": "Unknown",
            "1": "Internal",
            "2": "External",
            "99": "Other"
          },
          "description": "Which system holds the ticket, not what it is for."
        },
        "type": {
          "type": "string",
          "description": "The type_id caption, as OCSF names it: Internal or External."
        },
        "src_url": {
          "type": "string",
          "format": "uri"
        },
        "zerosoc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "Framework attributes of a ticket the Case raised.",
          "properties": {
            "kind": {
              "type": "string",
              "description": "What the ticket is for, which OCSF's type_id does not say. The framework names tuning, visibility, containment, eradication and recovery; the set is open while the response phase is still being designed."
            }
          }
        }
      },
      "description": "A ticket the Case raised. Borrowed from OCSF and intentionally open, so a platform's full ticket object validates unchanged."
    },
    "ocsf_trait": {
      "type": "object",
      "x-ocsf-object": "trait",
      "additionalProperties": true,
      "description": "The list of key traits or characteristics extracted from the finding, as the source stated them. What a trait holds depends on the finding it came from; the framework reserves no category and no name.",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The trait's name, as the source stated it."
        },
        "category": {
          "type": "string",
          "description": "The grouping the trait belongs to, where the source gives one."
        },
        "uid": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The threat names the source assigned."
        }
      }
    },
    "incident_category": {
      "type": "string",
      "pattern": "^IC-[0-9]{2}$"
    },
    "executor_class": {
      "type": "string",
      "enum": [
        "human",
        "automation",
        "agent"
      ]
    },
    "zerosoc_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_path",
        "provenance"
      ],
      "properties": {
        "candidate_incident_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/incident_category"
          }
        },
        "incident_category": {
          "$ref": "#/$defs/incident_category"
        },
        "reclassification_pivots": {
          "type": "array",
          "description": "Every change of candidate Incident Category, with the evidence that triggered it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/incident_category"
              },
              "to": {
                "$ref": "#/$defs/incident_category"
              },
              "reason": {
                "type": "string"
              },
              "event_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "entry_path": {
          "type": "string",
          "enum": [
            "alert",
            "hunt",
            "out-of-band"
          ]
        },
        "visibility_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "data_source",
              "check_prevented"
            ],
            "properties": {
              "data_source": {
                "type": "string"
              },
              "check_prevented": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "playbooks",
            "executors"
          ],
          "properties": {
            "playbooks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "version"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string",
                    "description": "The playbook's last_updated date."
                  }
                }
              }
            },
            "executors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/executor_class"
              },
              "minItems": 1
            },
            "capability_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ocsf_product"
              }
            }
          }
        },
        "significant": {
          "type": "boolean",
          "description": "NIS2 Article 23(3) significance test."
        },
        "cross_border": {
          "type": "boolean"
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "recipient",
              "deadline"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "internal",
                  "nis2-early-warning",
                  "nis2-notification",
                  "nis2-final-report",
                  "dora-initial",
                  "dora-intermediate",
                  "dora-final",
                  "other"
                ]
              },
              "recipient": {
                "type": "string"
              },
              "deadline": {
                "type": "integer",
                "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
              },
              "sent_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "OCSF timestamp_t: milliseconds since the Unix epoch (UTC)."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "handover_reason": {
          "type": "string",
          "enum": [
            "crown-jewel",
            "privileged-identity",
            "manual"
          ]
        },
        "watch_until": {
          "type": "integer",
          "description": "OCSF timestamp_t: monitoring watch on the Case's entities after an Insufficient Data or Low-confidence close."
        },
        "master_case_uid": {
          "type": "string",
          "description": "Set on a Duplicate close: the open master Case that handles the activity."
        }
      }
    },
    "ocsf_key_value_object": {
      "type": "object",
      "x-ocsf-object": "key_value_object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "values"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ocsf_analytic": {
      "type": "object",
      "x-ocsf-object": "analytic",
      "additionalProperties": true,
      "description": "What produced the Finding: the detection content that raised an Alert, the check that answered a triage question, or the validation query that tested a hypothesis. A Finding and what produced it are never separated.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The identifier of the check or query, where it has one; the event reference the Note cites for it otherwise."
        },
        "name": {
          "type": "string",
          "description": "The question it answers, in the words a reader of the Case understands — never the query language."
        },
        "type": {
          "type": "string",
          "description": "What kind of analytic it is, where `type_id` is Other: `triage check`, `validation query`, `enrichment`."
        },
        "type_id": {
          "type": "integer",
          "description": "OCSF's analytic type, which OCSF requires. A triage check and a validation query are none of OCSF's listed types, so they are Other (99) and `type` names them."
        },
        "desc": {
          "type": "string",
          "description": "What was asked, as the executor asked it — the telemetry, the entities and the window — before any tool translated it."
        },
        "algorithm": {
          "type": "string",
          "description": "The query the tool actually ran, in that tool's own language. It is what makes the Finding reproducible by someone holding neither the Case nor the executor."
        },
        "version": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      },
      "required": [
        "type_id"
      ]
    },
    "ocsf_graph_node": {
      "type": "object",
      "x-ocsf-object": "node",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "description": "The entity's value as it appears in observables."
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "The entity's OCSF observable type_id."
        },
        "desc": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "ocsf_graph_edge": {
      "type": "object",
      "x-ocsf-object": "edge",
      "additionalProperties": true,
      "required": [
